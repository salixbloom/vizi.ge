# --- light-maps tile server (run separately, reverse-proxied at /tiles) ---
TILE_SERVER_URL=http://127.0.0.1:8080

# --- storage ---
DATABASE_PATH=./data/vizi.db
UPLOAD_DIR=./data/uploads

# --- submission rate limiting ---
MAX_SUBMISSIONS_PER_DAY=3

# --- WA bounding box (override only if needed): minLng,minLat,maxLng,maxLat ---
WA_BBOX=-124.85,45.54,-116.91,49.05

# --- admin auth ---
ADMIN_USER=admin
# bcrypt-style/scrypt hash generated by scripts/hash-password.ts (NOT a plaintext password)
ADMIN_PASS_HASH=
# 32+ char random string for iron-session cookie encryption
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
