# Copy to .env and fill in. In Docker, pass at runtime with `--env-file .env`,
# EXCEPT NEXT_PUBLIC_* values, which are inlined at build time and must be
# supplied as build args (e.g. `--build-arg NEXT_PUBLIC_MAP_STYLE_URL=...`).

# --- map style (client-side; NEXT_PUBLIC_ = baked into the build) ---
# MapLibre style document URL. Defaults to the bundled /map-style.json.
# Set to /tiles/style.json to use the light-maps raster style.
NEXT_PUBLIC_MAP_STYLE_URL=/map-style.json

# --- light-maps tile server (run separately, reverse-proxied at /tiles) ---
TILE_SERVER_URL=http://127.0.0.1:8080
# WA land-cover rasters for light-maps to serve at /tiles/wa-rasters/{z}/{x}/{y}.webp.
# Directory of EPSG:2927 GeoTIFFs (+ ecopia_landcover_raster_colors.clr palette).
RASTER_DATA_PATH=~/data/washington-rasters

# --- storage ---
DATABASE_PATH=./data/vizi.db
UPLOAD_DIR=./data/uploads

# --- submission rate limiting ---
MAX_SUBMISSIONS_PER_DAY=3

# --- WA bounding box (override only if needed): minLng,minLat,maxLng,maxLat ---
WA_BBOX=-124.85,45.54,-116.91,49.05

# --- admin auth ---
ADMIN_USER=admin
# bcrypt-style/scrypt hash generated by scripts/hash-password.ts (NOT a plaintext password)
ADMIN_PASS_HASH=
# 32+ char random string for iron-session cookie encryption
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
